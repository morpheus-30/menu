ADMIN_PASSWORD=choose-a-long-password
GROQ_API_KEY=gsk_...
# optional, default shown (must be a Groq vision-capable model)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# added automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=

# WhatsApp bot (see docs/WHATSAPP_SETUP.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
# your number(s) with country code, digits only, comma separated e.g. 919876543210
ALLOWED_NUMBERS=
